{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/aiweb/result-v1.json",
  "title": "AIWebResult",
  "description": "Return value of service.handle and daemon IPC response body (architecture v2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "message",
    "request_id",
    "session_alive",
    "state",
    "busy"
  ],
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "Whether the operation completed successfully."
    },
    "message": {
      "type": "string",
      "description": "Short, TUI-safe text. Must not contain full large Grok bodies."
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "description": "Correlation id for logs and artifacts."
    },
    "session_alive": {
      "type": "boolean",
      "description": "daemon_up AND browser_up AND state in Ready|Busy|NeedsLogin."
    },
    "state": {
      "type": "string",
      "enum": [
        "DaemonDown",
        "BrowserDown",
        "Ready",
        "Busy",
        "NeedsLogin"
      ]
    },
    "busy": {
      "type": "boolean",
      "description": "True if a heavy op is in progress (usually false on return from handle)."
    },
    "daemon_up": {
      "type": "boolean"
    },
    "browser_up": {
      "type": "boolean"
    },
    "daemon_pid": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "protocol_version": {
      "type": "integer",
      "minimum": 1
    },
    "page_url": {
      "type": ["string", "null"]
    },
    "login_required": {
      "type": ["boolean", "null"]
    },
    "path": {
      "type": "string",
      "enum": ["small", "large", "none"],
      "description": "Response size path for chat. none = no capture (status/stop/clear)."
    },
    "chars": {
      "type": "integer",
      "minimum": 0,
      "description": "Character count of full captured text before inject distill."
    },
    "full_path": {
      "type": ["string", "null"],
      "description": "Path to last_response.md."
    },
    "gen_id": {
      "type": ["string", "null"],
      "description": "Capture generation id; more_state must match this gen_id."
    },
    "more_available": {
      "type": "boolean",
      "description": "True if /aiweb-more can return another chunk for current gen_id."
    },
    "chunk_index": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "chunk_total": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "inject": {
      "$ref": "#/$defs/inject_info"
    },
    "file_path": {
      "type": ["string", "null"],
      "description": "Path written by /aiweb-write."
    },
    "file_bytes": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "error": {
      "type": ["string", "null"],
      "description": "Human-readable error when ok=false."
    },
    "error_code": {
      "type": ["string", "null"],
      "enum": [
        null,
        "busy",
        "spawn_failed",
        "protocol_mismatch",
        "lock_held",
        "needs_login",
        "timeout",
        "empty_extract",
        "distill_empty",
        "write_rejected",
        "write_extract_failed",
        "browser_dead",
        "invalid_args",
        "internal"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Paths to screenshots/HTML/logs."
    },
    "op": {
      "type": ["string", "null"],
      "description": "Echo of handled op for debugging."
    }
  },
  "$defs": {
    "inject_info": {
      "type": "object",
      "additionalProperties": false,
      "required": ["written", "pending", "chars", "mode"],
      "properties": {
        "written": {
          "type": "boolean",
          "description": "model_context.md was written this op."
        },
        "pending": {
          "type": "boolean",
          "description": "inject_pending.flag set; awaiting next pre_llm_call pop."
        },
        "chars": {
          "type": "integer",
          "minimum": 0,
          "description": "Length of inject payload after cap."
        },
        "mode": {
          "type": "string",
          "enum": ["final_only", "path_only", "none"]
        },
        "distill_method": {
          "type": ["string", "null"],
          "enum": [
            null,
            "heading_final",
            "fence_largest",
            "tail_strip",
            "path_only",
            "empty"
          ]
        },
        "capped": {
          "type": "boolean",
          "description": "True if payload truncated to MODEL_PACK_CAP."
        },
        "cap": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "MODEL_PACK_CAP applied, if any."
        }
      }
    }
  }
}